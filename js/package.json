{
  "name": "hsk30",
  "version": "0.1.0",
  "description": "Grade Chinese text against a named HSK document: the 2025 HSK 3.0 exam syllabus (default), the 2021 national standard (GF0025-2021) or HSK 2.0. Every result records which one.",
  "keywords": [
    "hsk",
    "hsk3",
    "hsk 3.0",
    "chinese",
    "mandarin",
    "readability",
    "graded reader",
    "language learning",
    "cefr",
    "proficiency"
  ],
  "homepage": "https://github.com/harukicoder/hsk30/tree/main/js#readme",
  "bugs": "https://github.com/harukicoder/hsk30/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harukicoder/hsk30.git",
    "directory": "js"
  },
  "license": "MIT",
  "author": "Alvaro Serrano (https://orcid.org/0009-0006-4701-9026)",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": {
        "import": "./index.mjs",
        "require": "./index.cjs"
      },
      "default": "./index.cjs"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "data/*.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
